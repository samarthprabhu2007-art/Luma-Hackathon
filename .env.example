# Copy to .env and fill in. Never commit .env or paste these in chat.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_BASE=https://sandbox.cashfree.com/pg
CASHFREE_API_VERSION=2023-08-01

SARVAM_API_KEY=

# Public URL for Cashfree webhooks (ngrok). Leave empty to rely on polling.
PUBLIC_BASE_URL=
LENDER_NAME=Demo Finance

# Full organizer-provided endpoint, including /stuthir26-ranking/.
# Leave empty to use the identical local ranking engine.
RANKING_LAMBDA_URL=
RANKING_LAMBDA_TIMEOUT_SECONDS=10
RANKING_MODE=local
# Required for mutation/action endpoints when exposing the demo backend.
NEXTPAY_ACTION_TOKEN=

# Sarvam Voice Agents outbound calls (fill in .env, never commit real values)
SARVAM_VOICE_API_KEY=
SARVAM_VOICE_ORG_ID=
SARVAM_VOICE_WORKSPACE_ID=
SARVAM_VOICE_APP_ID=
SARVAM_VOICE_APP_VERSION=
SARVAM_VOICE_CONNECTION_ID=
SARVAM_VOICE_AGENT_PHONE=
